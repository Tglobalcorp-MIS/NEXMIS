# /etc/nexmis/nexmis.env  (chmod 640, owner root:nexmis)
NEXMIS_LISTEN=:8443
NEXMIS_PUBLIC_URL=https://mis.corp.local:8443
NEXMIS_TLS_CERT=/etc/nexmis/tls/server.crt
NEXMIS_TLS_KEY=/etc/nexmis/tls/server.key
# NEXMIS_TRUST_PROXY=true   # behind nginx/Caddy that terminates TLS

NEXMIS_DATABASE_URL=postgres://nexmis:CHANGE_ME@127.0.0.1:5432/nexmis?sslmode=disable
NEXMIS_DATA_DIR=/var/lib/nexmis
NEXMIS_AGENT_DIR=/var/lib/nexmis/agent

# First start only: password of the local "admin" account.
NEXMIS_INITIAL_ADMIN_PASSWORD=

NEXMIS_TIMEZONE=Asia/Taipei
NEXMIS_LOG_LEVEL=info
NEXMIS_LOG_FORMAT=json
