# Copy to .env and fill in. Keep this file secret and back it up.

# Hostname clients use to reach NEXMIS (must match the TLS certificate)
SERVER_NAME=mis.corp.local
PUBLIC_URL=https://mis.corp.local

# PostgreSQL password (generate: openssl rand -base64 24)
DB_PASSWORD=

# 32-byte master key encrypting stored secrets (generate: openssl rand -base64 32)
# Losing it makes the stored AD bind password unreadable. BACK IT UP.
MASTER_KEY=

# Initial password for the local "admin" account (first start only).
INITIAL_ADMIN_PASSWORD=

TIMEZONE=Asia/Taipei
NEXMIS_VERSION=1.0.0
